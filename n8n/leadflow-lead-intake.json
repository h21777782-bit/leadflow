{
  "id": "leadflow-lead-intake",
  "name": "LeadFlow — Lead Intake (Webhook → sign HMAC → POST → notify)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "leadflow-lead",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "1a1b1c1d-0001-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-40, 260],
      "webhookId": "leadflow-lead-intake"
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const crypto = require('crypto');\nconst secret = $env.WEBHOOK_SIGNING_SECRET;\nif (!secret) throw new Error('WEBHOOK_SIGNING_SECRET is not set on the n8n environment');\n\nconst body = $input.item.json.body ?? $input.item.json;\nif (!body.eventId) body.eventId = `n8n-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;\nif (!body.source) body.source = 'n8n';\n\nconst rawBody = JSON.stringify(body);\nconst timestamp = Math.floor(Date.now() / 1000);\nconst signature = 'sha256=' + crypto.createHmac('sha256', secret).update(`${timestamp}.${rawBody}`).digest('hex');\n\nreturn { json: { rawBody, timestamp, signature, eventId: body.eventId } };"
      },
      "id": "1a1b1c1d-0002-4000-8000-000000000002",
      "name": "Sign HMAC",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [180, 260]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LEADFLOW_BASE_URL }}/api/webhooks/leads",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-LeadFlow-Timestamp", "value": "={{ $json.timestamp }}" },
            { "name": "X-LeadFlow-Signature", "value": "={{ $json.signature }}" }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.rawBody }}",
        "options": {
          "response": { "response": { "neverError": true, "fullResponse": true } }
        }
      },
      "id": "1a1b1c1d-0003-4000-8000-000000000003",
      "name": "POST to LeadFlow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [400, 260]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "1a1b1c1d-0004-4000-8000-000000000004",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 400,
              "operator": { "type": "number", "operation": "lt" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "1a1b1c1d-0005-4000-8000-000000000005",
      "name": "IF success",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [620, 260]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "n1", "name": "notification", "type": "string", "value": "=[SIMULATED] Lead accepted: {{ $json.body.eventId }} (HTTP {{ $json.statusCode }})" }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "1a1b1c1d-0006-4000-8000-000000000006",
      "name": "Notify success",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [840, 160]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "n2", "name": "notification", "type": "string", "value": "=[SIMULATED] Lead REJECTED (HTTP {{ $json.statusCode }}): {{ JSON.stringify($json.body) }}" }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "1a1b1c1d-0007-4000-8000-000000000007",
      "name": "Notify failure",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [840, 360]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { status: $json.statusCode < 400 ? 'accepted' : 'rejected', leadflow: $json.body, notification: $json.notification } }}",
        "options": { "responseCode": 200 }
      },
      "id": "1a1b1c1d-0008-4000-8000-000000000008",
      "name": "Respond to caller",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [1060, 260]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Sign HMAC", "type": "main", "index": 0 }]] },
    "Sign HMAC": { "main": [[{ "node": "POST to LeadFlow", "type": "main", "index": 0 }]] },
    "POST to LeadFlow": { "main": [[{ "node": "IF success", "type": "main", "index": 0 }]] },
    "IF success": {
      "main": [
        [{ "node": "Notify success", "type": "main", "index": 0 }],
        [{ "node": "Notify failure", "type": "main", "index": 0 }]
      ]
    },
    "Notify success": { "main": [[{ "node": "Respond to caller", "type": "main", "index": 0 }]] },
    "Notify failure": { "main": [[{ "node": "Respond to caller", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
