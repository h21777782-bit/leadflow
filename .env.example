# ─── Database ────────────────────────────────────────────────────────────────
# Local Supabase (`npx supabase start`) prints this URL; plain Docker Postgres works too.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ─── App ─────────────────────────────────────────────────────────────────────
APP_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=USD
# No login in this demo — every UI action is attributed to this seeded user.
DEMO_ACTOR_EMAIL=admin@leadflow.example

# ─── Automation engine (Phase 4: job queue, worker, follow-ups) ──────────────
# All have working defaults (shown here) — only set these to change the demo timing.
FOLLOWUP_1_DELAY_SECONDS=30
JOB_MAX_ATTEMPTS=5
RETRY_BASE_DELAY_SECONDS=15
RETRY_MAX_DELAY_SECONDS=3600
JOB_LEASE_SECONDS=60
WORKER_POLL_MS=2000
WORKER_BATCH_SIZE=5
# Supabase transaction pooler (port 6543) does not support prepared statements → set false there.
# Plain Docker Postgres, Supabase session pooler, and direct connections all want true (the default).
DATABASE_PREPARE=true

# ─── Integration mode ────────────────────────────────────────────────────────
# true  = all HighLevel calls go to the isolated mock provider (no credentials needed)
# false = real HighLevel API (requires the HIGHLEVEL_* values below)
MOCK_MODE=true

# ─── HighLevel (only when MOCK_MODE=false) ───────────────────────────────────
HIGHLEVEL_API_BASE_URL=https://services.leadconnectorhq.com
HIGHLEVEL_API_VERSION=2021-07-28
HIGHLEVEL_PRIVATE_TOKEN=
HIGHLEVEL_LOCATION_ID=
HIGHLEVEL_PIPELINE_ID=
HIGHLEVEL_CALENDAR_ID=
# Ed25519 public key used to verify the X-GHL-Signature header on inbound webhooks
HIGHLEVEL_WEBHOOK_PUBLIC_KEY=

# ─── Our own webhook signing (website forms / n8n → this app) ────────────────
# Generate with: openssl rand -hex 32
WEBHOOK_SIGNING_SECRET=

# ─── Tests ───────────────────────────────────────────────────────────────────
# Separate database for integration tests (the suite wipes and reseeds it).
# Leave empty to skip DB integration tests.
TEST_DATABASE_URL=
