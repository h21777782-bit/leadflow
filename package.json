{
  "name": "leadflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "npm run db:migrate && npm run db:seed",
    "db:studio": "drizzle-kit studio",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "env:check": "tsx scripts/check-env.ts",
    "demo:routing": "tsx scripts/demo-routing.ts",
    "demo:a": "tsx scripts/demo-a.ts",
    "demo:b": "tsx scripts/demo-b.ts",
    "demo:c": "tsx scripts/demo-c.ts",
    "worker": "tsx scripts/worker.ts",
    "worker:once": "tsx scripts/worker.ts --once"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "drizzle-orm": "^0.45.2",
    "libphonenumber-js": "^1.13.13",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20.9"
  }
}
